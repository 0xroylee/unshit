{
  "name": "unshit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-backed implementation plans from a plain-language software brief.",
  "bin": {
    "unshit": "dist/unshit"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "check": "bun run typecheck && bun test",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/cli.ts --compile --outfile dist/unshit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "typescript": "^5.9.3"
  }
}
